{
  "$defs": {
    "CallMetrics": {
      "properties": {
        "calls": {
          "title": "Calls",
          "type": "integer"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "title": "Cost Usd",
          "type": "number"
        },
        "unpriced_calls": {
          "title": "Unpriced Calls",
          "type": "integer"
        },
        "latency_p50_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency P50 S"
        },
        "latency_p95_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency P95 S"
        },
        "cost_per_receipt_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Per Receipt Usd"
        },
        "cost_per_month_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Per Month Usd"
        }
      },
      "required": [
        "calls",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "unpriced_calls",
        "latency_p50_s",
        "latency_p95_s",
        "cost_per_receipt_usd",
        "cost_per_month_usd"
      ],
      "title": "CallMetrics",
      "type": "object"
    },
    "CallUsage": {
      "properties": {
        "step": {
          "title": "Step",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "latency_s": {
          "title": "Latency S",
          "type": "number"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Usd"
        }
      },
      "required": [
        "step",
        "model",
        "latency_s",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "title": "CallUsage",
      "type": "object"
    },
    "CaseResult": {
      "description": "One receipt of the scenario.",
      "properties": {
        "receipt": {
          "title": "Receipt",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/LineScore"
          },
          "title": "Lines",
          "type": "array"
        },
        "reading": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadingScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/CallUsage"
          },
          "title": "Calls",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "receipt",
        "lines",
        "calls"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "CatalogMetrics": {
      "properties": {
        "lines": {
          "title": "Lines",
          "type": "integer"
        },
        "hits": {
          "title": "Hits",
          "type": "integer"
        },
        "hit_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hit Rate"
        },
        "carried_errors": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/ErrorKind"
          },
          "title": "Carried Errors",
          "type": "object"
        }
      },
      "required": [
        "lines",
        "hits",
        "hit_rate",
        "carried_errors"
      ],
      "title": "CatalogMetrics",
      "type": "object"
    },
    "Counts": {
      "properties": {
        "true_positives": {
          "default": 0,
          "title": "True Positives",
          "type": "integer"
        },
        "false_positives": {
          "default": 0,
          "title": "False Positives",
          "type": "integer"
        },
        "false_negatives": {
          "default": 0,
          "title": "False Negatives",
          "type": "integer"
        }
      },
      "title": "Counts",
      "type": "object"
    },
    "ErrorKind": {
      "enum": [
        "wrong_existing",
        "new_instead_of_existing",
        "existing_instead_of_new",
        "duplicate",
        "wrong_fit",
        "name_differs",
        "noise",
        "not_noise",
        "unknown",
        "not_unknown",
        "no_result",
        "pack_size"
      ],
      "type": "string"
    },
    "ExpectedOutcome": {
      "enum": [
        "existing",
        "new",
        "noise",
        "unknown"
      ],
      "type": "string"
    },
    "JsonValue": {},
    "KindChoiceMetrics": {
      "properties": {
        "lines": {
          "title": "Lines",
          "type": "integer"
        },
        "errors": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/ErrorKind"
          },
          "title": "Errors",
          "type": "object"
        },
        "noise_recognised": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Noise Recognised"
        },
        "unknown_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unknown Rate"
        },
        "names_differ": {
          "items": {
            "$ref": "#/$defs/NameDiff"
          },
          "title": "Names Differ",
          "type": "array"
        }
      },
      "required": [
        "lines",
        "errors",
        "noise_recognised",
        "unknown_rate",
        "names_differ"
      ],
      "title": "KindChoiceMetrics",
      "type": "object"
    },
    "Label": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "alternatives": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Label",
      "type": "object"
    },
    "LineScore": {
      "description": "One labelled line scored: what was due, what the flow did, and the mistake if any.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "expected": {
          "$ref": "#/$defs/ExpectedOutcome"
        },
        "expected_quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Kind"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind_correct": {
          "title": "Kind Correct",
          "type": "boolean"
        },
        "quantity_correct": {
          "title": "Quantity Correct",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind_existed": {
          "default": false,
          "title": "Kind Existed",
          "type": "boolean"
        },
        "catalog_conflict": {
          "default": false,
          "title": "Catalog Conflict",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "label",
        "expected",
        "expected_quantity",
        "outcome",
        "kind",
        "quantity",
        "kind_correct",
        "quantity_correct",
        "error"
      ],
      "title": "LineScore",
      "type": "object"
    },
    "Metrics": {
      "properties": {
        "f1": {
          "title": "F1",
          "type": "number"
        },
        "kind_f1": {
          "title": "Kind F1",
          "type": "number"
        },
        "purchases": {
          "$ref": "#/$defs/Counts"
        },
        "kinds": {
          "$ref": "#/$defs/Counts"
        },
        "choose_kinds": {
          "$ref": "#/$defs/KindChoiceMetrics"
        },
        "catalog": {
          "$ref": "#/$defs/CatalogMetrics"
        },
        "write": {
          "$ref": "#/$defs/WriteMetrics"
        },
        "calls": {
          "$ref": "#/$defs/CallMetrics"
        },
        "calls_by_step": {
          "additionalProperties": {
            "$ref": "#/$defs/CallMetrics"
          },
          "title": "Calls By Step",
          "type": "object"
        },
        "reading": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadingMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "f1",
        "kind_f1",
        "purchases",
        "kinds",
        "choose_kinds",
        "catalog",
        "write",
        "calls",
        "calls_by_step"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "Misread": {
      "properties": {
        "truth": {
          "title": "Truth",
          "type": "string"
        },
        "read": {
          "title": "Read",
          "type": "string"
        }
      },
      "required": [
        "truth",
        "read"
      ],
      "title": "Misread",
      "type": "object"
    },
    "NameDiff": {
      "description": "A new kind made for a label and named otherwise.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "created": {
          "title": "Created",
          "type": "string"
        }
      },
      "required": [
        "label",
        "created"
      ],
      "title": "NameDiff",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "existing",
        "new",
        "unknown",
        "noise",
        "no_result"
      ],
      "type": "string"
    },
    "Pair": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      ],
      "type": "array"
    },
    "Quantity": {
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "ReadingCounts": {
      "description": "What reading got right, counted over one receipt or summed over a scenario.",
      "properties": {
        "receipts": {
          "default": 0,
          "title": "Receipts",
          "type": "integer"
        },
        "truth_lines": {
          "default": 0,
          "title": "Truth Lines",
          "type": "integer"
        },
        "read_lines": {
          "default": 0,
          "title": "Read Lines",
          "type": "integer"
        },
        "aligned": {
          "default": 0,
          "title": "Aligned",
          "type": "integer"
        },
        "missed": {
          "default": 0,
          "title": "Missed",
          "type": "integer"
        },
        "extra": {
          "default": 0,
          "title": "Extra",
          "type": "integer"
        },
        "text_right": {
          "default": 0,
          "title": "Text Right",
          "type": "integer"
        },
        "quantity_right": {
          "default": 0,
          "title": "Quantity Right",
          "type": "integer"
        },
        "price_right": {
          "default": 0,
          "title": "Price Right",
          "type": "integer"
        },
        "discounts": {
          "default": 0,
          "title": "Discounts",
          "type": "integer"
        },
        "discounts_right": {
          "default": 0,
          "title": "Discounts Right",
          "type": "integer"
        },
        "discounts_extra": {
          "default": 0,
          "title": "Discounts Extra",
          "type": "integer"
        },
        "chain_right": {
          "default": 0,
          "title": "Chain Right",
          "type": "integer"
        },
        "date_right": {
          "default": 0,
          "title": "Date Right",
          "type": "integer"
        },
        "self_checked": {
          "default": 0,
          "title": "Self Checked",
          "type": "integer"
        },
        "self_check_passed": {
          "default": 0,
          "title": "Self Check Passed",
          "type": "integer"
        }
      },
      "title": "ReadingCounts",
      "type": "object"
    },
    "ReadingMetrics": {
      "description": "The reading step's metrics over a scenario, as rates from 0 to 1; None when there is\nnothing to rate.",
      "properties": {
        "counts": {
          "$ref": "#/$defs/ReadingCounts"
        },
        "line_text": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line Text"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price"
        },
        "discount_pairing": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Discount Pairing"
        },
        "chain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Chain"
        },
        "date": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date"
        },
        "self_check_pass_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Self Check Pass Rate"
        },
        "missed_lines": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Missed Lines"
        },
        "extra_lines": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Extra Lines"
        }
      },
      "required": [
        "counts",
        "line_text",
        "quantity",
        "price",
        "discount_pairing",
        "chain",
        "date",
        "self_check_pass_rate",
        "missed_lines",
        "extra_lines"
      ],
      "title": "ReadingMetrics",
      "type": "object"
    },
    "ReadingScore": {
      "description": "One receipt's reading: its counts, the alignment, and the lines behind the errors.",
      "properties": {
        "counts": {
          "$ref": "#/$defs/ReadingCounts"
        },
        "pairs": {
          "items": {
            "$ref": "#/$defs/Pair"
          },
          "title": "Pairs",
          "type": "array"
        },
        "missed": {
          "items": {
            "type": "string"
          },
          "title": "Missed",
          "type": "array"
        },
        "extra": {
          "items": {
            "type": "string"
          },
          "title": "Extra",
          "type": "array"
        },
        "misread": {
          "items": {
            "$ref": "#/$defs/Misread"
          },
          "title": "Misread",
          "type": "array"
        }
      },
      "required": [
        "counts",
        "pairs",
        "missed",
        "extra",
        "misread"
      ],
      "title": "ReadingScore",
      "type": "object"
    },
    "Source": {
      "enum": [
        "catalog",
        "model"
      ],
      "type": "string"
    },
    "StepRun": {
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "options": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "model",
        "options"
      ],
      "title": "StepRun",
      "type": "object"
    },
    "Unit": {
      "enum": [
        "kg",
        "l",
        "szt"
      ],
      "type": "string"
    },
    "WriteMetrics": {
      "properties": {
        "kind_conflicts": {
          "title": "Kind Conflicts",
          "type": "integer"
        },
        "catalog_conflicts": {
          "title": "Catalog Conflicts",
          "type": "integer"
        },
        "quantities_checked": {
          "title": "Quantities Checked",
          "type": "integer"
        },
        "purchase_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Purchase Quantity"
        }
      },
      "required": [
        "kind_conflicts",
        "catalog_conflicts",
        "quantities_checked",
        "purchase_quantity"
      ],
      "title": "WriteMetrics",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "flow": {
      "const": "receipt-lines",
      "default": "receipt-lines",
      "title": "Flow",
      "type": "string"
    },
    "date": {
      "format": "date-time",
      "title": "Date",
      "type": "string"
    },
    "commit": {
      "title": "Commit",
      "type": "string"
    },
    "configuration": {
      "title": "Configuration",
      "type": "string"
    },
    "flow_version": {
      "title": "Flow Version",
      "type": "string"
    },
    "steps": {
      "additionalProperties": {
        "$ref": "#/$defs/StepRun"
      },
      "title": "Steps",
      "type": "object"
    },
    "scenario": {
      "title": "Scenario",
      "type": "string"
    },
    "look_up": {
      "title": "Look Up",
      "type": "boolean"
    },
    "metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "skipped": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Skipped",
      "type": "array"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "date",
    "commit",
    "configuration",
    "flow_version",
    "steps",
    "scenario",
    "look_up",
    "metrics",
    "cases"
  ],
  "title": "RunResult",
  "type": "object"
}
